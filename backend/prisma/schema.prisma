generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Character {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  class_type  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Feedback {
  id                 Int      @id @default(autoincrement())
  correctCharacter   String
  predictedCharacter String
  isCorrect          Boolean  @default(true) // Tracks whether the prediction was correct
  imageData          String   // Base64 image
  isDownloaded       Boolean  @default(false) // Tracks if Python script has downloaded it for training
  createdAt          DateTime @default(now())
}
