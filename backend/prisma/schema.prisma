generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Character {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String
  class_type  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
